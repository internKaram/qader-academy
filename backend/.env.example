# Server Port (e.g. 5000 for local dev and container runtime)
PORT=5000

# Environment Mode (use 'development' for local dev, or 'production' for deployment)
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection URI)
MONGO_URI=

# Security Configuration (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=

# Allowed Frontend URL for CORS (e.g. http://localhost:5173 for local dev, or https://<your-frontend-url> for prod, comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

# Internal Certificate Service Endpoint (e.g. http://localhost:5000/api/v1/certificates)
CERT_SERVICE_URL=http://localhost:5000/api/v1/certificates